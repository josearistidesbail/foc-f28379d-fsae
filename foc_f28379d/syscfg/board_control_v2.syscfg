/**
 * Write custom configuration values to the imported modules.
 */
adc1.$name             = "myADCA";
adc1.adcClockPrescaler = "ADC_CLK_DIV_4_0";
adc1.enabledSOCs       = ["ADC_SOC_NUMBER0"];
adc1.soc0Trigger       = "ADC_TRIGGER_EPWM4_SOCA";
adc1.soc0Channel       = "ADC_CH_ADCIN2";
adc1.soc0SampleWindow  = 15;

adc2.$name             = "myADCB";
adc2.adcBase           = "ADCB_BASE";
adc2.adcClockPrescaler = "ADC_CLK_DIV_4_0";
adc2.enabledSOCs       = ["ADC_SOC_NUMBER0","ADC_SOC_NUMBER1"];
adc2.soc0Trigger       = "ADC_TRIGGER_EPWM4_SOCA";
adc2.soc0Channel       = "ADC_CH_ADCIN4";
adc2.soc0SampleWindow  = 15;
adc2.soc1Trigger       = "ADC_TRIGGER_EPWM4_SOCA";
adc2.soc1Channel       = "ADC_CH_ADCIN2";
adc2.soc1SampleWindow  = 15;

adc3.$name                    = "myADCC";
adc3.adcBase                  = "ADCC_BASE";
adc3.adcClockPrescaler        = "ADC_CLK_DIV_4_0";
adc3.enabledSOCs              = ["ADC_SOC_NUMBER0","ADC_SOC_NUMBER1"];
adc3.soc0Trigger              = "ADC_TRIGGER_EPWM4_SOCA";
adc3.soc0Channel              = "ADC_CH_ADCIN4";
adc3.soc0SampleWindow         = 15;
adc3.soc1Trigger              = "ADC_TRIGGER_EPWM4_SOCA";
adc3.soc1Channel              = "ADC_CH_ADCIN2";
adc3.enabledInts              = ["ADC_INT_NUMBER1"];
adc3.interruptPulseMode       = "ADC_PULSE_END_OF_CONV";
adc3.enableInterrupt1         = true;
adc3.interrupt1SOCSource      = "ADC_SOC_NUMBER1";
adc3.registerInterrupts       = ["1"];
adc3.soc1SampleWindow         = 512;
adc3.adcInt1.enableInterrupt  = true;
adc3.adcInt1.interruptHandler = "adcA1_isr";

led1.$name                = "LED_STATUS";
led1.gpio.gpioPin.$assign = "GPIO31";

epwm1.$name                                                      = "PWM_U";
epwm1.epwmTimebase_counterMode                                   = "EPWM_COUNTER_MODE_UP_DOWN";
epwm1.epwmTimebase_hsClockDiv                                    = "EPWM_HSCLOCK_DIVIDER_1";
epwm1.epwmTimebase_period                                        = 5000;
epwm1.epwmTimebase_syncOutPulseMode                              = "EPWM_SYNC_OUT_PULSE_ON_COUNTER_ZERO";
epwm1.epwmCounterCompare_cmpA                                    = 2500;
epwm1.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_UP_CMPA   = "EPWM_AQ_OUTPUT_HIGH";
epwm1.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_DOWN_CMPA = "EPWM_AQ_OUTPUT_LOW";
epwm1.epwmDeadband_enableRED                                     = true;
epwm1.epwmDeadband_enableFED                                     = true;
epwm1.epwmDeadband_delayRED                                      = 150;
epwm1.epwmDeadband_delayFED                                      = 150;
epwm1.epwmDeadband_polarityFED                                   = "EPWM_DB_POLARITY_ACTIVE_LOW";
epwm1.epwmEventTrigger_EPWM_SOC_A_triggerEnable                  = true;
epwm1.epwmEventTrigger_EPWM_SOC_A_triggerSource                  = "EPWM_SOC_TBCTR_ZERO";
epwm1.epwmEventTrigger_EPWM_SOC_A_triggerEventPrescalar          = "1";
epwm1.epwmTripZone_oneShotSource                                 = ["EPWM_TZ_SIGNAL_OSHT1","EPWM_TZ_SIGNAL_OSHT2","EPWM_TZ_SIGNAL_OSHT3"];
epwm1.epwmTripZone_EPWM_TZ_ACTION_EVENT_TZA                      = "EPWM_TZ_ACTION_LOW";
epwm1.epwmTripZone_EPWM_TZ_ACTION_EVENT_TZB                      = "EPWM_TZ_ACTION_HIGH";
epwm1.epwmTripZone_tzInterruptSource                             = ["EPWM_TZ_INTERRUPT_OST"];
epwm1.epwmTripZone_registerInterrupts                            = true;
epwm1.epwm.$assign                                               = "EPWM4";
epwm1.epwm.epwm_aPin.$assign                                     = "GPIO6";
epwm1.epwm.epwm_bPin.$assign                                     = "GPIO7";
epwm1.epwmTZInt.interruptHandler                                 = "epwm_tz_isr";
epwm1.epwmTZInt.enableInterrupt                                  = true;

epwm2.$name                                                      = "PWM_V";
epwm2.epwmTimebase_counterMode                                   = "EPWM_COUNTER_MODE_UP_DOWN";
