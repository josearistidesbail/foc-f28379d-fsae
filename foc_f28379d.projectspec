<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
  <project
        name="foc_f28379d"
        device="TMS320F28379D"
        cgtVersion="22.6.0.LTS"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
        enableSysConfigTool="true"
        sysConfigBuildOptions="--product ${C2000WARE_ROOT}/.metadata/sdk.json --device F2837xD --package F2837xD_337ZWT --part F2837xD_337ZWT"
        >

    <!-- =================================================================== -->
    <!-- Build configuration: Debug variant - BOOSTXL-DRV8305 + Teknic + QEP -->
    <!-- =================================================================== -->
    <configuration
        name="Debug_BOOSTXL_Teknic_QEP"
        compilerBuildOptions="-v28 -ml -mt --float_support=fpu32 --tmu_support=tmu0 -O2 --opt_for_speed=5 --fp_mode=relaxed
                              -I${PROJECT_LOC}
                              -I${PROJECT_LOC}/include
                              -I${PROJECT_LOC}/config
                              -I${C2000WARE_DEVICE_SUPPORT_ROOT}/common/include
                              -I${C2000WARE_DEVICE_SUPPORT_ROOT}/headers/include
                              -I${C2000WARE_DLIB_ROOT}
                              -I${SDK_ROOT}/libraries/math/include
                              -I${SDK_ROOT}/libraries/transforms/clarke/include
                              -I${SDK_ROOT}/libraries/transforms/park/include
                              -I${SDK_ROOT}/libraries/transforms/ipark/include
                              -I${SDK_ROOT}/libraries/transforms/svgen/include
                              -I${SDK_ROOT}/libraries/control/pi/include
                              -I${SDK_ROOT}/libraries/utilities/filters/fo/include
                              -I${SDK_ROOT}/solutions/tidm_02014_traction_inverter/common/include
                              --define=HW_BOOSTXL_DRV8305
                              --define=MOTOR_TEKNIC_M2310P
                              --define=SENSOR_QEP
                              --define=_DEBUG --define=_FLASH --define=CPU1
                              --define=_F2837X --define=F2837x_DEVICE --define=_DUAL_HEADERS
                              --define=LARGE_MODEL -g --diag_warning=225 --diag_suppress=10063
                              --quiet -k --asm_listing --gen_func_subsections=on --abi=eabi"
        linkerBuildOptions="--entry_point code_start --stack_size=0x380 --reread_libs -llibc.a" />

    <!-- =================================================================== -->
    <!-- Build configuration: Production variant - Custom + EMRAX + Resolver -->
    <!-- =================================================================== -->
    <configuration
        name="Production_CtrlV2_EMRAX_Resolver"
        compilerBuildOptions="-v28 -ml -mt --float_support=fpu32 --tmu_support=tmu0 -O3 --opt_for_speed=5 --fp_mode=relaxed
                              -I${PROJECT_LOC}
                              -I${PROJECT_LOC}/include
                              -I${PROJECT_LOC}/config
                              -I${C2000WARE_DEVICE_SUPPORT_ROOT}/common/include
                              -I${C2000WARE_DEVICE_SUPPORT_ROOT}/headers/include
                              -I${C2000WARE_DLIB_ROOT}
                              -I${SDK_ROOT}/libraries/math/include
                              -I${SDK_ROOT}/libraries/transforms/clarke/include
                              -I${SDK_ROOT}/libraries/transforms/park/include
                              -I${SDK_ROOT}/libraries/transforms/ipark/include
                              -I${SDK_ROOT}/libraries/transforms/svgen/include
                              -I${SDK_ROOT}/libraries/control/pi/include
                              -I${SDK_ROOT}/libraries/utilities/filters/fo/include
                              -I${SDK_ROOT}/solutions/tidm_02014_traction_inverter/common/include
                              --define=HW_CONTROL_BOARD_V2
                              --define=MOTOR_EMRAX_208
                              --define=SENSOR_RM44AC
                              --define=_FLASH --define=CPU1
                              --define=_F2837X --define=F2837x_DEVICE --define=_DUAL_HEADERS
                              --define=LARGE_MODEL -g --diag_warning=225 --diag_suppress=10063
                              --quiet -k --asm_listing --gen_func_subsections=on --abi=eabi"
        linkerBuildOptions="--entry_point code_start --stack_size=0x380 --reread_libs -llibc.a" />

    <!-- =================================================================== -->
    <!-- Path variables                                                       -->
    <!-- =================================================================== -->
    <pathVariable name="SDK_ROOT"                     path="C:/ti/C2000Ware_MotorControl_SDK_5_04_00_00" scope="project" />
    <pathVariable name="C2000WARE_ROOT"               path="C:/ti/C2000Ware_MotorControl_SDK_5_04_00_00/c2000ware" scope="project" />
    <pathVariable name="C2000WARE_DEVICE_SUPPORT_ROOT" path="C:/ti/C2000Ware_MotorControl_SDK_5_04_00_00/c2000ware/device_support/f2837xd" scope="project" />
    <pathVariable name="C2000WARE_DLIB_ROOT"          path="C:/ti/C2000Ware_MotorControl_SDK_5_04_00_00/c2000ware/driverlib/f2837xd/driverlib" scope="project" />

    <!-- =================================================================== -->
    <!-- Application source files (this repository)                          -->
    <!-- =================================================================== -->
    <file action="link" path="src/main.c"                  targetDirectory="src" />
    <file action="link" path="src/foc_pipeline.c"          targetDirectory="src" />
    <file action="link" path="src/foc_state_machine.c"     targetDirectory="src" />
    <file action="link" path="src/sensor_qep.c"            targetDirectory="src" />
    <file action="link" path="src/sensor_rm44ac.c"         targetDirectory="src" />
    <file action="link" path="src/adc_iface.c"             targetDirectory="src" />
    <file action="link" path="src/pwm_iface.c"             targetDirectory="src" />
    <file action="link" path="src/inverter_drv8305.c"      targetDirectory="src" />
    <file action="link" path="src/inverter_custom_v2.c"    targetDirectory="src" />
    <file action="link" path="src/safety.c"                targetDirectory="src" />
    <file action="link" path="src/isr.c"                   targetDirectory="src" />
    <file action="link" path="src/debug_hooks.c"           targetDirectory="src" />

    <!-- Per-variant SysConfig file (the unused one is excluded per config) -->
    <file action="link" path="syscfg/board_boostxl_drv8305.syscfg" targetDirectory=""
          applicableConfigurations="Debug_BOOSTXL_Teknic_QEP" />
    <file action="link" path="syscfg/board_control_v2.syscfg"      targetDirectory=""
          applicableConfigurations="Production_CtrlV2_EMRAX_Resolver" />

    <!-- =================================================================== -->
    <!-- TI MotorControl SDK math/control library sources                    -->
    <!-- =================================================================== -->
    <file action="link" path="SDK_ROOT/libraries/transforms/clarke/source/clarke.c"        targetDirectory="ti_lib" />
    <file action="link" path="SDK_ROOT/libraries/transforms/park/source/park.c"            targetDirectory="ti_lib" />
    <file action="link" path="SDK_ROOT/libraries/transforms/ipark/source/ipark.c"          targetDirectory="ti_lib" />
    <file action="link" path="SDK_ROOT/libraries/transforms/svgen/source/svgen.c"          targetDirectory="ti_lib" />
    <file action="link" path="SDK_ROOT/libraries/control/pi/source/pi.c"                   targetDirectory="ti_lib" />
    <file action="link" path="SDK_ROOT/libraries/utilities/filters/fo/source/filter_fo.c"  targetDirectory="ti_lib"
          applicableConfigurations="Production_CtrlV2_EMRAX_Resolver" />

    <!-- =================================================================== -->
    <!-- F2837xD device support, target config, linker cmd, driverlib lib     -->
    <!-- =================================================================== -->
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/targetConfigs/TMS320F28379D.ccxml" targetDirectory="" />
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/cmd/2837xD_FLASH_lnk_cpu1.cmd"    targetDirectory="src_device" />
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/cmd/F2837xD_Headers_nonBIOS_cpu1.cmd" targetDirectory="src_device" />

    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/source/device.c"                  targetDirectory="src_device" />
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/headers/source/F2837xD_GlobalVariableDefs.c" targetDirectory="src_device" />
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/source/F2837xD_CodeStartBranch.asm"   targetDirectory="src_device" />

    <!-- Pre-built driverlib + needed driverlib sources -->
    <file action="link" path="C2000WARE_DLIB_ROOT/ccs/Release/driverlib.lib" targetDirectory="" />

  </project>
</projectSpec>
